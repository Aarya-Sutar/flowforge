# Copy this file to .env and fill in real values for local development.
# Never commit the real .env file.

# --- PostgreSQL ---
POSTGRES_USER=flowforge
POSTGRES_PASSWORD=flowforge
POSTGRES_DB=flowforge

# --- Backend ---
# Used by the backend when running outside Docker Compose (e.g. `uvicorn` directly).
DATABASE_URL=postgresql+psycopg2://flowforge:flowforge@localhost:5432/flowforge

# Secret used to sign JWTs. Generate a real one with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=change-me-in-production

# --- Celery / Redis ---
# Used by the backend and celery-worker when running outside Docker Compose.
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# --- Frontend ---
# Baked into the frontend at BUILD time (Next.js public env var convention).
NEXT_PUBLIC_API_URL=http://localhost:8000
